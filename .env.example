# Shared project variables for Vercel; copy to .env and apps/api/.env locally.
# Never commit populated .env files.

# Public browser configuration (available during the SvelteKit build)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# API runtime configuration; never use a PUBLIC_ prefix for service-role keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-SERVICE-ROLE-KEY

# Public web origin for QR links and CORS. On Vercel, set your HTTPS domain.
# If omitted, VERCEL_URL supplies the current deployment's public origin.
APP_URL=http://localhost:5173

# Standalone development only; vercel dev manages routing and ports itself.
PORT=3001
API_DEV_URL=http://127.0.0.1:3001

# No PUBLIC_API_URL or WEB_URL: browser calls use same-origin /api/*.
# No service binding variables are manually configured.
QR_SECRET=REPLACE-WITH-A-LONG-RANDOM-SECRET
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
CRON_SECRET=
